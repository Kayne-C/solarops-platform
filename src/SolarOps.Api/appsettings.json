{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:5080", "Protocols": "Http1" },
      "Grpc": { "Url": "http://localhost:5081", "Protocols": "Http2" }
    }
  },
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=solarops.db",
    "ApplyMigrationsOnStartup": false,
    "SeedDemoData": false
  },
  "ConnectionStrings": {
    "Redis": ""
  },
  "Messaging": {
    "Transport": "InMemory",
    "ConsumersEnabled": false,
    "RabbitMq": {
      "ConnectionString": "amqp://guest:guest@localhost:5672/",
      "Exchange": "solarops.events",
      "QueuePrefix": "solarops",
      "PrefetchCount": 16
    },
    "Outbox": {
      "Enabled": true,
      "BatchSize": 100,
      "PollingInterval": "00:00:01",
      "MaxAttempts": 10
    }
  },
  "Jwt": {
    "Issuer": "solarops",
    "Audience": "solarops-api",
    "SigningKey": "",
    "TokenLifetime": "01:00:00"
  },
  "RateLimiting": {
    "TenantPermitsPerSecond": 50,
    "TenantBurst": 200,
    "TokenRequestsPerMinute": 10
  }
}
