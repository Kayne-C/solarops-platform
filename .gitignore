###############################################################################
#  GLOBAL NODE / JS PROJELERİ                                                #
###############################################################################
/node_modules
.pnp/
.pnp.js

# Ortak build/Release klasörleri
/build
/build/Release

###############################################################################
#  PROJEYE ÖZGÜ KLASÖRLER (ÖNEMLİ!)                                          #
#  ✅ Kendi dizinlerinize göre uyarlayın                                      #
###############################################################################

# Backend
backend/node_modules/
backend/.env*               # Tek satırla tüm .env varyantlarını ignore edebilirsiniz
backend/build/              # Eğer TypeScript veya Webpack çıktısı varsa

# Frontend (React)
frontend/node_modules/
frontend/build/             # React 'npm run build' çıktısı
frontend/.env*              # Örneğin .env.development.local

###############################################################################
# LOGS / CACHE / OUTPUT                                                      #
###############################################################################
# (mevcut satırlar zaten iyi; tekrarlayanları sildim)
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.nyc_output
coverage/
*.lcov
.cache/
.parcel-cache/
...

###############################################################################
# ENV / DOTENV DOSYALARI                                                     #
###############################################################################
.env
.env.*                       # Hangi klasörde olursa olsun tüm .env.* dosyaları
!.env.example                # örnek dosya repoda kalsın

###############################################################################
# IDE / TOOLING                                                             #
###############################################################################
.vscode/
.idea/
*.swp
*.swo
